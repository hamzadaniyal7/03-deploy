# Where the gateway sends requests. Comma-separated for failover.
SELFSERVE_BACKENDS=http://localhost:8000

# Optional bearer token the gateway requires from clients.
SELFSERVE_API_KEY=

# Any config key can be overridden with a SELFSERVE_ prefix:
# SELFSERVE_MAX_CONCURRENCY=64
# SELFSERVE_QUEUE_LIMIT=256
# SELFSERVE_REQUEST_TIMEOUT=120
